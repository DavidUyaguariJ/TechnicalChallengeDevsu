<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <!-- The Dockerfile builds from the repository root (it needs Shared + the other layers). -->
    <DockerfileContext>..\..\..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.JsonPatch.SystemTextJson" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Must stay on the 2.x line: Microsoft.AspNetCore.OpenApi 10.0.12 pins [2.12.0, 3.0.0),
         and its source generator targets the 2.x API. 2.12.2 is above 2.7.5, the fix for
         GHSA-v5pm-xwqc-g5wc / CVE-2026-49451 (stack overflow on circular schema references). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.3" />
    <!-- Visual Studio Container Tools: enables the "Container (Dockerfile)" launch profile (F5 into Docker). -->
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Devsu.PersonCustomer.Application\Devsu.PersonCustomer.Application.csproj" />
    <ProjectReference Include="..\Devsu.PersonCustomer.Infrastructure\Devsu.PersonCustomer.Infrastructure.csproj" />
  </ItemGroup>

</Project>
